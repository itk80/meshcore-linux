#!/bin/sh
set -e

case "$1" in
  configure)
    # Config file ships as a dpkg conffile (see debian/conffiles) — on
    # fresh install it lands at /etc/Meshcore-Linux/config.json with
    # placeholder modem.host. On upgrade dpkg preserves whatever the
    # operator changed (passwords, identity, modem endpoint).

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      if deb-systemd-helper --quiet was-enabled Meshcore-Linux.service; then
        deb-systemd-helper enable Meshcore-Linux.service >/dev/null || true
      else
        deb-systemd-helper update-state Meshcore-Linux.service >/dev/null || true
      fi
      # Don't auto-start on first install — the seeded config has a
      # placeholder modem.host. Operator edits then `systemctl start`.
      if [ -n "$2" ]; then
        systemctl try-restart Meshcore-Linux.service >/dev/null 2>&1 || true
      else
        echo "meshcore-linux installed. Edit /etc/Meshcore-Linux/config.json"
        echo "(set modem.host) then: sudo systemctl start Meshcore-Linux"
      fi
    fi
    ;;
esac

#DEBHELPER#

exit 0
