#!/usr/bin/make -f
# Driven by debhelper compat 13. Builds via the in-tree Makefile;
# debian/install handles file placement; dh_systemd_* wires the unit.

export DH_VERBOSE = 1

# MeshCore upstream lives in a sibling checkout; CI pulls it into
# ../MeshCore before invoking dpkg-buildpackage. Local builds need
# the same — see README "Build from source".
%:
	dh $@

override_dh_auto_build:
	$(MAKE)

override_dh_auto_install:
	# Default `make install` doesn't exist in our Makefile, so suppress
	# it. dh_install handles regular file placement from debian/install.
	# Conffile placement is done here because we need to RENAME the
	# example into the live config path:
	#   /usr/share/meshcore-linux/config.example.json (template, always shipped)
	#   /etc/Meshcore-Linux/config.json                (conffile, never overwritten on upgrade)
	install -D -m 0640 config/config.example.json \
	        debian/meshcore-linux/etc/Meshcore-Linux/config.json

override_dh_auto_clean:
	-$(MAKE) clean
