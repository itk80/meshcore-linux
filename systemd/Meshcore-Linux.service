[Unit]
Description=MeshCore-Linux — mesh::Radio bridge over pymc_usb/pymc_tcp
Documentation=https://github.com/itk80/MeshCore
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/meshcore-linux /etc/Meshcore-Linux/config.json
# `always` (not on-failure) so that intentional clean exits — operator
# clicking Reboot in the UI, `reboot` CLI verb, LinuxMainBoard::reboot()
# — also bring the service back automatically. exit(0) is how the binary
# signals "I'm done, please restart me" since we have no in-process
# self-restart on Linux.
Restart=always
RestartSec=5s
# stdout/stderr go to systemd-journal — `journalctl -fu Meshcore-Linux` to follow.
StandardOutput=journal
StandardError=journal
# Run as root for now (binds :5060 and reads/writes /etc/Meshcore-Linux/).
# Tighten with a dedicated user + CAP_NET_BIND_SERVICE if/when we move the
# config API to a privileged port — :5060 is unprivileged anyway, so an
# unprivileged user works too. Reserved for follow-up.
User=root
# Modest hardening that's safe for a single-process TCP-only service.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/Meshcore-Linux /var/lib/Meshcore-Linux
StateDirectory=Meshcore-Linux
StateDirectoryMode=0750
PrivateTmp=true

[Install]
WantedBy=multi-user.target
